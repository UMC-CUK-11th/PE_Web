  "item": [
    {
      "name": "준비 A 회원가입",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"nickname\": \"{{nicknameA}}\",\n  \"password\": \"Movie123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "{",
              "const id = Date.now().toString(36);",
              "pm.collectionVariables.set(\"emailA\", `w8a.${id}@example.com`);",
              "pm.collectionVariables.set(\"emailB\", `w8b.${id}@example.com`);",
              "pm.collectionVariables.set(\"nicknameA\", `w8a${id}`.slice(-12));",
              "pm.collectionVariables.set(\"nicknameB\", `w8b${id}`.slice(-12));",
              "pm.collectionVariables.unset(\"tokenA\");",
              "pm.collectionVariables.unset(\"tokenB\");",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "{",
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const week08Result = pm.response.json();",
              "pm.test(\"응답 코드와 성공 여부\", () => {",
              "  pm.expect(week08Result.code).to.eql(\"COMMON201\");",
              "  pm.expect(week08Result.isSuccess).to.eql(true);",
              "});",
              "",
              "pm.collectionVariables.set(\"memberIdA\", week08Result.result.memberId);",
              "}"
            ]
          }
        }
      ]
    },
