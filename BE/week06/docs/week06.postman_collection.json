{
  "info": {
    "name": "week06 Standard Mission - 순서대로 실행",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "01~19 순서대로 실행. 서버와 DB를 먼저 준비하세요. 테스트용 회원 2명은 DB에 남습니다. 평점은 마지막에 삭제됩니다. 재실행은 01부터 시작하세요."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01 회원가입 - 201 / memberId 저장",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner{{runSuffix}}@example.com\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"m{{runSuffix}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runSuffix', Date.now().toString().slice(-8));",
              "['memberId','otherMemberId','ratingId'].forEach(k => pm.collectionVariables.unset(k));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('No password in response', () => pm.expect(pm.response.json().result).not.to.have.property('password'));",
              "if (pm.response.code === 201) pm.collectionVariables.set('memberId', pm.response.json().result.memberId);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 다른 회원 가입 - 201",
