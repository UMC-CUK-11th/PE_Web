                                                    }
                                                ],
                                     "url":  "{{baseUrl}}/members",
                                     "body":  {
                                                  "raw":  "{\"email\":\"owner{{runId}}@example.com\",\"password\":\"Umc!1234\",\"nickname\":\"a{{runId}}\"}",
                                                  "options":  {
                                                                  "raw":  {
                                                                              "language":  "json"
                                                                          }
                                                              },
                                                  "mode":  "raw"
                                              }
                                 },
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.test(\u0027HTTP 201\u0027, () =\u003e pm.response.to.have.status(201));",
                                                                   "const b = pm.response.json(); pm.collectionVariables.set(\u0027memberId\u0027, b.result.memberId);",
                                                                   "pm.test(\u0027password excluded\u0027, () =\u003e pm.expect(pm.response.json().result).not.to.have.property(\u0027password\u0027));"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   },
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.collectionVariables.set(\u0027runId\u0027, Date.now().toString().slice(-10));"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "prerequest"
                                   }
                               ]
