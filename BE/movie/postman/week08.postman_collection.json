    {
      "name": "01 signup-a",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"{{nickA}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const run = Date.now().toString(36);",
              "for (const id of ['A','B']) { pm.collectionVariables.set('email'+id, 'w8'+id+run+'@example.com'); pm.collectionVariables.set('nick'+id, id+run); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"code COMMON201\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON201\"));",
              "pm.test(\"응답 확인\", () => { const result = pm.response.json().result; pm.collectionVariables.set('memberA', result.memberId); });"
            ]
          }
        }
      ]
    },
