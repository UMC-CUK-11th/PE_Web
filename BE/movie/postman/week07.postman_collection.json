{
  "info": {
    "name": "UMC 7주차 인증 인가 검증",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "01부터 순서대로 실행. 03,09,08,05 필수 캡처. localhost 임시 테스트 계정만 사용."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01 A 회원가입",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"{{nicknameA}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix=Date.now().toString(36); pm.collectionVariables.set(\"emailA\",\"w7a\"+suffix+\"@umc.com\"); pm.collectionVariables.set(\"emailB\",\"w7b\"+suffix+\"@umc.com\"); pm.collectionVariables.set(\"nicknameA\",\"a\"+suffix); pm.collectionVariables.set(\"nicknameB\",\"b\"+suffix);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "pm.test(\"code COMMON201\",()=>pm.expect(pm.response.json().code).to.eql(\"COMMON201\"));",
              "pm.collectionVariables.set('memberA',pm.response.json().result.memberId);"
            ]
          }
        }
      ]
    },
