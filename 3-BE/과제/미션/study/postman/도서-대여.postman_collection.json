{
  "info": {
    "name": "UMC 3-BE 도서 대여",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8083"
    },
    {
      "key": "rentalId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "실습 도서 목록",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "실습 도서 등록",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryId\": 1,\n  \"title\": \"클린 코드\",\n  \"description\": \"좋은 코드를 작성하는 방법\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "필수 1 카테고리별 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books/category/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "필수 2 신규 대여",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/rentals",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"bookId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"rentalId\", pm.response.json().rental_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "선택 도서 반납",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{baseUrl}}/rentals/{{rentalId}}/return"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
