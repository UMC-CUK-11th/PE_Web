# 이 파일은 Git에 올리지 않을 로컬 생성 파일을 정한다.
# 개발 서버·빌드·패키지 설치가 만든 파일은 다시 생성할 수 있어 제외한다.

# 실행 도중 생긴 로그
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 설치된 패키지와 빌드 결과물
node_modules
dist
dist-ssr
*.local

# 개인 편집기 설정과 운영체제 임시 파일
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
