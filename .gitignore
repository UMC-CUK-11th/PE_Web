# Only keep the backend and frontend projects in this repository.
/*
!/.gitignore
!/BE/
!/FE/

# Dependencies and package-manager caches
**/node_modules/
**/.gradle/
**/.npm/
**/.yarn/cache/
**/.pnpm-store/

# Build output, generated files, and test coverage
**/build/
**/dist/
**/dist-ssr/
**/out/
**/target/
**/coverage/
**/.tanstack/
**/.vite/
**/.cache/
**/.tmp/
**/tmp/
**/temp/
**/*.class

# Local environment files and logs
**/.env
**/.env.*
!**/.env.example
**/*.local
**/*.log
**/logs/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# IDE and OS metadata
**/.idea/
**/.vscode/
**/.settings/
**/.classpath
**/.project
**/*.iml
**/*.iws
**/*.ipr
**/.DS_Store
**/Thumbs.db

# Tool-specific local state
**/.postman/
**/.sts4-cache/
**/.apt_generated/
